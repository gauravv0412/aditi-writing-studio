# Copy this file to ".env" and fill in your values.

# Your Anthropic API key (https://console.anthropic.com/ -> API keys).
# Required for the AI to write. You can also paste it inside the app's Settings.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A simple password to open the app. Leave blank for no password (only do that locally).
APP_PASSWORD=

# Which Claude model writes the articles. Opus 4.8 is the best for style matching.
MODEL=claude-opus-4-8
